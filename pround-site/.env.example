# ---- Copie para .env.local e preencha (nunca commite o .env.local) ----
# Na Vercel, estas mesmas variáveis vão em: Project Settings > Environment Variables.

# Banco PostgreSQL (Neon, Railway, local...). No Neon use a URL "pooled" (com -pooler no host).
DATABASE_URL=postgres://usuario:senha@localhost:5432/pround

# Segredo que assina os logins (32+ caracteres aleatórios). Trocar depois desloga todo mundo e invalida links de e-mail.
# Gerar: openssl rand -base64 32   (Windows/PowerShell: [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256})))
BETTER_AUTH_SECRET=troque-por-um-valor-aleatorio-de-32-ou-mais-caracteres

# Endereço público do site. Na Vercel pode ficar em branco (usa o domínio de produção);
# com domínio próprio, preencha:  https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Administrador fixo (criado/garantido automaticamente a cada deploy) ----
# Você entra no site com este e-mail e senha. Use uma senha longa e única (10+ caracteres, maiúscula, minúscula e número).
# Depois do primeiro deploy você pode apagar o ADMIN_PASSWORD da Vercel: o administrador continua existindo.
# ADMIN_EMAIL=voce@seudominio.com.br
# ADMIN_PASSWORD=
# ADMIN_NAME=Seu Nome
# Para TROCAR a senha do admin: mude ADMIN_PASSWORD, crie ADMIN_RESET_PASSWORD=true, faça deploy e depois apague a ADMIN_RESET_PASSWORD.

# ---- E-mail (recuperação de senha e avisos para a equipe; o cadastro NÃO exige confirmar e-mail) ----
# Resend (https://resend.com): crie a chave e VERIFIQUE o domínio de envio.
RESEND_API_KEY=
EMAIL_FROM="Proud <contato@seudominio.com.br>"
# Quem recebe o aviso de novo briefing/chamado (separe vários por vírgula). Opcional, mas recomendado.
ADMIN_NOTIFY_EMAIL=

# Só para testar localmente SEM Resend: imprime os e-mails (com os links) no terminal.
# É ignorado na Vercel em produção.
# EMAIL_TRANSPORT=log
